# ---------------------------------------------------------------------------
# Content OS — environment variables. Copy to .env.local for local dev.
# NEVER commit real values. NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# Public URL of this deployment (used for auth email links and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Used exclusively to write encrypted social credentials.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Social connections (optional in Phase 1; Instagram is disabled if unset) ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY_V1=
TOKEN_ENCRYPTION_CURRENT_VERSION=1
# Generate with: openssl rand -base64 48
OAUTH_STATE_SECRET=
# Meta app → Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Discover (optional) ---
# YouTube Data API v3 key (search + most-popular chart). Unset → YouTube source unavailable.
YOUTUBE_API_KEY=
DISCOVER_TRENDING_REGION=US

# --- Analysis worker (npm run worker; needs ffmpeg/ffprobe on PATH) ---
# Direct Postgres connection string (Supabase → Settings → Database). SERVER ONLY.
DATABASE_URL=
# Claude API key for structured analysis. Required for analyses to complete.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5
# Script Lab creative agents (Phase 3) use the same key.
CREATIVE_MODEL=claude-opus-5-5
CREATIVE_EFFORT=high
# Server-side refusal fallbacks are on by default; set to 1 to disable.
ANTHROPIC_DISABLE_FALLBACKS=
# OpenAI key for Whisper transcription. Unset → analyses run without a transcript.
OPENAI_API_KEY=
WORKER_ID=
WORKER_POLL_INTERVAL_MS=3000
# Development only: read/write media from a local directory instead of Supabase Storage.
MEDIA_STORE_LOCAL_DIR=

# --- Tests only ---
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/content_os_test
